# `npm run setup:mint` writes .env.local for you. These are the settings it can hold.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_MINT=
VITE_MINT_DECIMALS=6
VITE_CURRENCY_LABEL=Demo USD
# Devnet only: secret key of the demo mint authority (ships to the browser).
VITE_DEMO_MINT_AUTHORITY=
# Where check links point. Set to your LAN address or deployed URL so phones can open them.
VITE_PUBLIC_URL=
# Override program ids if you deploy your own copies.
# VITE_SIGNER_PROGRAM_ID=EdSigVfK1DkeMrjFNDMjwfQaJPhPTtX7jW8uPv3oKEgN
